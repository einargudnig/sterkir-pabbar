{
  "name": "sterkir-pabbar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "content": "node scripts/fetch-content.mjs",
    "build": "node scripts/fetch-content.mjs && astro build",
    "preview": "astro preview",
    "lint": "oxlint .",
    "typecheck": "astro check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxlint . && oxfmt --check . && astro check && (cd innri && bun run typecheck && bun run test && bun run build)",
    "types:sanity": "(cd studio && bun run typegen)"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@oxlint/plugins": "1.83.0",
    "@shadcn/lint": "0.1.0",
    "oxfmt": "^0.58.0",
    "oxlint": "1.83.0",
    "shadcn": "^4.21.0",
    "typescript": "^5"
  }
}
