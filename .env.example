# Sanity — content source for the build.
# Copy to .env and fill in after creating the project at https://sanity.io/manage
#
# The site builds fine without any of these: scripts/fetch-content.mjs falls
# back to the committed src/content/content.json.

SANITY_PROJECT_ID=
SANITY_DATASET=production

# Only needed if the dataset is private. A public dataset needs no token, and
# public is the right default here — the content is a public landing page.
# SANITY_READ_TOKEN=

# Only for the one-time `node scripts/seed-sanity.mjs` run. Do NOT put this in
# Vercel; the build never writes to Sanity.
# SANITY_WRITE_TOKEN=

# The studio (studio/.env) uses its own prefixed copies:
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=production
