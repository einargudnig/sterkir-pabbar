---
import "../styles/global.css";
import { site } from "../config/site";
import { buildJsonLd } from "../lib/jsonLd";

interface Props {
  title?: string;
  description?: string;
  /** Path relative to the site root, e.g. "/" */
  path?: string;
  /**
   * Keep the page out of the index and suppress its structured data.
   * Error pages need both: they must not rank, and emitting the business
   * @graph from an error URL would claim a second canonical home for the
   * same entity.
   */
  noindex?: boolean;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
  path = "/",
  noindex = false,
} = Astro.props;

const canonical = new URL(path, site.domain).href;

/**
 * Social share card. Absolute URL is required — crawlers do not resolve
 * relative paths, so this breaks if `site.domain` is wrong (still TODO).
 *
 * public/og.png is generated, not hand-drawn: render the card markup at
 * exactly 1200x630 and screenshot it. Regenerate whenever the headline or
 * palette changes, or the shared link stops matching the page it opens.
 */
const ogImage = new URL("/og.png", site.domain).href;
const jsonLd = noindex ? null : JSON.stringify(buildJsonLd());
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#221c16" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!--
      Preconnect not needed: fonts are self-hosted. Preload only faces that
      render above the fold, largest-first.

      fraunces-italic was previously omitted, which was the wrong call: it sets
      "orka" in the h1 — the emphasis word in the largest type on the page — so
      the one word the design leans on was the one that swapped in late.

      Orbitron is deliberately NOT preloaded. It sets the wordmark only, at
      0.82rem, where a swap costs almost nothing.
    -->
    <link
      rel="preload"
      href="/fonts/fraunces-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/fraunces-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/hanken-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/logo/icon-512.png" />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} is:inline />}
  </head>
  <body>
    {/* #efni is the homepage's main landmark; pages without it target #meginmal,
        which every page wrapper provides. */}
    <a href={noindex ? "#meginmal" : "#efni"} class="skip-link">Fara í meginmál</a>
    <slot />

    <style>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -4rem;
        z-index: 200;
        background: var(--color-bronze);
        color: var(--color-base);
        padding: 0.7rem 1.1rem;
        border-radius: 0.5rem;
        font-weight: 600;
        transition: top 220ms var(--ease-out-expo);
      }
      .skip-link:focus {
        top: 1rem;
      }
    </style>
  </body>
</html>
