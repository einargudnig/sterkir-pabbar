---
import { site, nav } from "../config/site";
import { bookingHref } from "../lib/booking";
---

<header class="site-header">
  <div class="shell bar">
    <a href="#efni" class="wordmark" aria-label={`${site.name} — heim`}>
      <span class="crest-mark mark" aria-hidden="true"></span>
      <span class="wordmark-text">{site.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Aðalvalmynd">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    {/*
      Visible at every width now. This was `display: none` below 900px, so on a
      phone the only persistent route to the one conversion goal was opening the
      hamburger — on the device this audience actually browses on, at night, in
      fragments, when the moment of "fine, I'll do it" is unpredictable.
    */}
    <div class="header-cta">
      <a href={bookingHref} class="btn btn-primary btn-sm">
        <span class="cta-long">Ókeypis spjall</span>
        <span class="cta-short">Spjall</span>
      </a>
    </div>

    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Opna valmynd"
    >
      <span></span><span></span>
    </button>
  </div>

  <div class="scroll-progress" aria-hidden="true"></div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <nav class="shell" aria-label="Valmynd">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={bookingHref} class="btn btn-primary">Ókeypis spjall</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklch, var(--color-base) 78%, transparent);
    backdrop-filter: saturate(1.5) blur(14px);
    -webkit-backdrop-filter: saturate(1.5) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 260ms ease, background-color 260ms ease;
  }
  .site-header[data-scrolled] {
    background: color-mix(in oklch, var(--color-base) 88%, transparent);
    border-bottom-color: var(--color-line-soft);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.5rem;
  }

  /* Reading progress, driven entirely by scroll position — no JS, and it
     costs one hairline of chrome. */
  .scroll-progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 100%;
    background: var(--color-bronze);
    transform: scaleX(0);
    transform-origin: left center;
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .scroll-progress {
        animation: progress-grow linear both;
        animation-timeline: scroll(root block);
      }
    }
  }
  @keyframes progress-grow {
    to {
      transform: scaleX(1);
    }
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-text);
  }
  .wordmark-text {
    font-family: var(--font-mark);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    /* The persistent CTA narrows the bar on small screens; without this the
       wordmark breaks across two lines. */
    white-space: nowrap;
  }
  @media (max-width: 419px) {
    .wordmark-text {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
    }
    .mark {
      width: 1.75rem;
    }
  }
  .mark {
    width: 2.05rem;
    --crest-color: var(--color-bronze);
    transition: transform 400ms var(--ease-out-expo);
  }
  @media (hover: hover) and (pointer: fine) {
    .wordmark:hover .mark {
      transform: translateY(-2px);
    }
  }

  .desktop-nav {
    display: none;
    gap: 2rem;
    margin-inline-start: auto;
    margin-inline-end: 1.75rem;
  }
  .desktop-nav a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-muted);
    position: relative;
    transition: color 200ms ease;
  }
  .desktop-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -5px;
    height: 1px;
    width: 100%;
    background: var(--color-bronze);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 320ms var(--ease-out-expo);
  }
  @media (hover: hover) and (pointer: fine) {
    .desktop-nav a:hover {
      color: var(--color-text);
    }
    .desktop-nav a:hover::after {
      transform: scaleX(1);
      transform-origin: left center;
    }
  }

  .btn-sm {
    padding: 0.65rem 1.2rem;
    font-size: 0.875rem;
  }
  .header-cta {
    margin-inline-start: auto;
  }
  /* The label shortens rather than the button disappearing. */
  .cta-short {
    display: none;
  }
  @media (max-width: 419px) {
    .cta-long {
      display: none;
    }
    .cta-short {
      display: inline;
    }
    .btn-sm {
      /* keeps the tap target at ~44px once the label shortens */
      padding: 0.9rem 1.05rem;
    }
  }

  .menu-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    margin-inline-start: 0.75rem;
    border-radius: 0.65rem;
    border: 1px solid var(--color-line);
    background: transparent;
    transition: border-color 200ms ease;
  }
  .menu-toggle span {
    display: block;
    width: 1.15rem;
    height: 1.5px;
    margin-inline: auto;
    background: var(--color-text);
    transition:
      transform 320ms var(--ease-out-expo),
      opacity 200ms ease;
  }
  .menu-toggle[aria-expanded="true"] {
    border-color: var(--color-bronze-dim);
  }
  .menu-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mobile-nav {
    border-top: 1px solid var(--color-line-soft);
    background: var(--color-sunken);
    overflow: hidden;
  }
  .mobile-nav nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 1rem 1.75rem;
  }
  /* Toggling `hidden` flips display, which restarts these — so the panel
     staggers open without any JS driving the animation. */
  .mobile-nav nav > * {
    opacity: 0;
    animation: nav-item-in 420ms var(--ease-out-expo) forwards;
  }
  @keyframes nav-item-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .mobile-nav nav > *:nth-child(1) {
    animation-delay: 20ms;
  }
  .mobile-nav nav > *:nth-child(2) {
    animation-delay: 70ms;
  }
  .mobile-nav nav > *:nth-child(3) {
    animation-delay: 120ms;
  }
  .mobile-nav nav > *:nth-child(4) {
    animation-delay: 170ms;
  }
  .mobile-nav nav a:not(.btn) {
    padding: 0.85rem 0;
    /* Sans, not the display serif: these are navigation controls, not
       editorial text, and the serif was doing interface work it isn't for. */
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-line-soft);
  }
  .mobile-nav nav .btn {
    margin-top: 1rem;
    align-self: flex-start;
  }

  @media (min-width: 900px) {
    .desktop-nav {
      display: flex;
    }
    .header-cta {
      margin-inline-start: 0;
    }
    .menu-toggle {
      display: none;
    }
    .mobile-nav {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const panel = document.getElementById("mobile-nav");

  if (toggle && panel) {
    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Loka valmynd" : "Opna valmynd");
      panel.hidden = !open;
      // Stop the page scrolling behind the open panel.
      document.body.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(!isOpen());
    });

    panel.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => setOpen(false)),
    );

    // Dismiss by tapping anywhere outside the panel — previously the only ways
    // out were Escape or picking a link, which is a trap on a touch device.
    document.addEventListener("click", (e) => {
      if (!isOpen()) return;
      if (panel.contains(e.target as Node)) return;
      setOpen(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  if (header) {
    const onScroll = () => {
      if (window.scrollY > 8) header.setAttribute("data-scrolled", "");
      else header.removeAttribute("data-scrolled");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
