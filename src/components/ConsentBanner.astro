---
/**
 * Analytics consent. Google Analytics loads with every storage type denied
 * (see Layout.astro); this banner is the only thing that grants it. The
 * choice lives in localStorage under the same key Layout.astro reads, so a
 * returning visitor is granted before the first pageview is sent.
 */
---

<div class="consent" data-consent-banner hidden role="region" aria-label="Vafrakökur">
  <p class="consent-text">
    Við notum Google Analytics til að sjá hvernig síðan er notuð. Vafrakökur eru aðeins settar ef
    þú samþykkir. <a href="/personuvernd">Nánar</a>
  </p>
  <div class="consent-actions">
    <button type="button" class="btn btn-ghost consent-btn" data-consent="denied">Hafna</button>
    <button type="button" class="btn btn-primary consent-btn" data-consent="granted">
      Samþykkja
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = "sp-analytics-consent";
    var banner = document.querySelector("[data-consent-banner]");
    if (!banner) return;

    var stored = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch (e) {}
    // The listener is attached either way: /personuvernd can reopen the banner
    // for a visitor who has already chosen.
    banner.hidden = stored === "granted" || stored === "denied";
    banner.addEventListener("click", function (event) {
      var button = event.target.closest("[data-consent]");
      if (!button) return;
      var choice = button.getAttribute("data-consent");
      try {
        localStorage.setItem(KEY, choice);
      } catch (e) {}
      if (typeof gtag === "function") {
        gtag("consent", "update", { analytics_storage: choice });
      }
      banner.hidden = true;
    });
  })();
</script>

<style>
  .consent {
    position: fixed;
    z-index: 150;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    translate: -50% 0;
    width: min(100% - 2rem, 40rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: var(--color-raised);
    box-shadow: 0 18px 40px -20px oklch(0 0 0 / 0.6);
  }
  .consent[hidden] {
    display: none;
  }
  .consent-text {
    flex: 1 1 18rem;
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-text-soft);
  }
  .consent-text a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .consent-actions {
    display: flex;
    gap: 0.6rem;
  }
  .consent-btn {
    padding: 0.75rem 1.2rem;
    font-size: 0.92rem;
  }
</style>
