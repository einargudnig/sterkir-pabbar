---
import { testimonials } from "../config/site";
---

<section class="section testimonials">
  <div class="shell">
    <p class="kicker">Frá pöbbunum</p>
    <div class="quote-grid">
      {
        testimonials.map((t) => (
          <figure class="quote">
            <blockquote>
              <p>{t.quote}</p>
            </blockquote>
            <figcaption>
              <span class="q-name">{t.name}</span>
              <span class="q-detail">{t.detail}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .quote-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .quote {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(1.75rem, 1rem + 2vw, 2.5rem);
    border-radius: 1.25rem;
    background: var(--color-paper-raised);
    border: 1px solid var(--color-line);
    position: relative;
  }
  .quote::before {
    content: "„";
    font-family: var(--font-display);
    font-size: 4.5rem;
    line-height: 0.7;
    color: var(--color-clay);
    opacity: 0.45;
  }
  blockquote p {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.2rem, 1rem + 1vw, 1.6rem);
    line-height: 1.32;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: auto;
  }
  .q-name {
    font-weight: 600;
  }
  .q-detail {
    font-size: 0.9rem;
    color: var(--color-ink-faint);
  }

  @media (min-width: 800px) {
    .quote-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }
    .quote:nth-child(even) {
      transform: translateY(1.75rem);
    }
  }
</style>
