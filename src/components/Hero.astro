---
import { hero } from "../config/site";
import { bookingHref } from "../lib/booking";

const [before, after] = hero.headline.split(hero.emphasis);
---

<section class="hero" id="efni">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-crest" aria-hidden="true">
    <span class="crest-mark"></span>
  </div>

  <div class="shell hero-inner">
    {/*
      The tracked-caps eyebrow that sat here was dropped. A tiny uppercase
      letter-spaced label above an oversized headline is the default AI SaaS
      hero, and it was redundant three ways over: the wordmark already reads
      STERKIR PABBAR, the headline names the children, and the line below names
      the training. That removed the last `.kicker` on the page.
    */}
    <h1 class="hero-title rise" style="animation-delay: 200ms">
      {before}<em>{hero.emphasis}</em>{after}
    </h1>

    <p class="hero-sub rise" style="animation-delay: 380ms">{hero.sub}</p>

    <div class="hero-actions rise" style="animation-delay: 500ms">
      <a href={bookingHref} class="btn btn-primary">
        {hero.primaryCta.label}
      </a>
      <a href={hero.secondaryCta.href} class="link-arrow">
        {hero.secondaryCta.label}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M2 8h11M9 4l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>

  {/*
    The stat rail that sat here (3× á viku · 30–45 mínútur · 12 vikur) is gone
    — see the note on `hero.proof` in config/site.ts. Nothing replaces it: the
    hero now ends on the action, and the first real claim the visitor meets is
    Aron in his own words.
  */}
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: clamp(36rem, calc(100svh - 4.5rem), 56rem);
    padding-block: clamp(2rem, 1.5rem + 3vw, 3.5rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
    overflow: hidden;
  }

  /* Warm light source, top-right. A lit room, not a glow effect. */
  .hero-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        58% 46% at 76% 6%,
        color-mix(in oklch, var(--color-bronze) 15%, transparent),
        transparent 72%
      ),
      radial-gradient(
        70% 50% at 12% 96%,
        color-mix(in oklch, var(--color-slate) 42%, transparent),
        transparent 70%
      );
  }

  /* The crest at architectural scale — bleeding off the right edge so it
     reads as part of the wall, not as a logo placed on top of it. */
  .hero-crest {
    position: absolute;
    z-index: 0;
    top: 50%;
    right: -18%;
    width: min(78vw, 40rem);
    translate: 0 -50%;
    pointer-events: none;
  }
  .hero-crest .crest-mark {
    width: 100%;
    --crest-color: var(--color-bronze);
    opacity: 0;
    scale: 1.07;
    animation: crest-in 1.8s var(--ease-out-expo) 240ms forwards;
  }
  @keyframes crest-in {
    to {
      opacity: 0.085;
      scale: 1;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-title {
    font-size: var(--text-hero);
    font-weight: 430;
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin-block: clamp(1.25rem, 1rem + 1vw, 2rem) 0;
    max-width: 15ch;
    text-wrap: pretty;
  }
  .hero-title em {
    position: relative;
    font-style: italic;
    font-weight: 400;
    color: var(--color-bronze);
    /* Fraunces' quirk axes, ignored gracefully where unavailable */
    font-variation-settings: "SOFT" 0, "WONK" 1;
  }
  /* Swash that draws itself under the emphasised word once the
     headline has settled — the one flourish on the page. */
  .hero-title em::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.06em;
    height: 0.045em;
    min-height: 2px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.45;
    transform: scaleX(0);
    transform-origin: left center;
    animation: swash-in 900ms var(--ease-out-expo) 900ms forwards;
  }
  @keyframes swash-in {
    to {
      transform: scaleX(1);
    }
  }

  .hero-sub {
    font-size: var(--text-lead);
    color: var(--color-text-soft);
    max-width: 38ch;
    margin-top: clamp(1.5rem, 1.25rem + 1vw, 2.25rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  @media (min-width: 900px) {
    .hero-crest {
      right: -8%;
      width: min(52vw, 44rem);
    }
  }
</style>
