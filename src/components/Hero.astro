---
import { hero, site } from "../config/site";
---

<section class="hero" id="efni">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="shell hero-inner">
    <p class="kicker rise" style="animation-delay: 40ms">{hero.kicker}</p>

    <span
      class="crest-mark hero-crest rise"
      style="animation-delay: 100ms"
      aria-hidden="true"></span>

    <h1 class="wordmark-hero rise" style="animation-delay: 170ms">{site.name}</h1>

    <p class="tagline rise" style="animation-delay: 240ms">{site.tagline}</p>

    <p class="hero-sub rise" style="animation-delay: 300ms">{hero.sub}</p>

    <div class="hero-actions rise" style="animation-delay: 370ms">
      <a href={hero.primaryCta.href} class="btn btn-primary">{hero.primaryCta.label}</a>
      <a href={hero.secondaryCta.href} class="btn btn-ghost">{hero.secondaryCta.label}</a>
    </div>
  </div>

  <div class="shell">
    <dl class="proof rise" style="animation-delay: 450ms">
      {
        hero.proof.map((p) => (
          <div class="proof-item">
            <dt>{p.value}</dt>
            <dd>{p.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    text-align: center;
    padding-block: clamp(2.5rem, 1rem + 7vw, 5rem) clamp(2.5rem, 1rem + 4vw, 4rem);
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    top: clamp(1rem, 6vw, 5rem);
    left: 50%;
    transform: translateX(-50%);
    width: min(92vw, 42rem);
    height: 32rem;
    background: radial-gradient(
      circle at 50% 42%,
      color-mix(in oklch, var(--color-forest) 42%, transparent),
      transparent 62%
    );
    opacity: 0.35;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-inner .kicker {
    justify-content: center;
    color: var(--color-clay-deep);
  }

  .hero-crest {
    width: clamp(8.5rem, 26vw, 14rem);
    margin-block: 1.5rem 1.75rem;
    --crest-color: var(--color-clay);
    filter: drop-shadow(0 14px 26px oklch(0 0 0 / 0.55));
  }

  .wordmark-hero {
    font-family: var(--font-wordmark);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.05;
    font-size: clamp(1.85rem, 1rem + 5.4vw, 4rem);
    /* Brushed-bronze wordmark treatment — brand logotype, applied only here */
    background: linear-gradient(
      168deg,
      var(--color-clay-tint) 0%,
      var(--color-forest-deep) 88%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .tagline {
    margin-top: 1.1rem;
    font-size: clamp(1.25rem, 1rem + 1.4vw, 1.85rem);
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .hero-sub {
    margin-top: 1rem;
    max-width: 42ch;
    font-size: var(--text-lead);
    color: var(--color-ink-soft);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.75rem, 0.5rem + 1vw, 2rem);
    max-width: 44rem;
    margin: clamp(2.5rem, 1.5rem + 3vw, 4rem) auto 0;
    padding-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    border-top: 1px solid var(--color-line);
    text-align: center;
  }
  .proof-item dt {
    font-family: var(--font-wordmark);
    font-size: clamp(1.3rem, 1rem + 1.6vw, 2.1rem);
    font-weight: 600;
    line-height: 1;
    color: var(--color-clay);
  }
  .proof-item dd {
    margin-top: 0.6rem;
    font-size: clamp(0.72rem, 0.65rem + 0.3vw, 0.85rem);
    line-height: 1.35;
    color: var(--color-ink-faint);
  }
</style>
