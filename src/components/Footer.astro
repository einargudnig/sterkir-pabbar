---
import { site, nav } from "../config/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a href="#efni" class="wordmark">
        <span class="crest-mark mark" aria-hidden="true"></span>
        <span class="wordmark-text">{site.name}</span>
      </a>
      <p class="footer-tag">{site.tagline}.</p>
    </div>

    {/* These were <h2>, which put "Efni" and "Hafa samband" at the same outline
        level as the page's real section headings. Both landmarks are already
        labelled, so the visible text does not need to be a heading at all. */}
    <nav class="footer-col" aria-label="Vefkort">
      <p class="footer-heading">Efni</p>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="footer-col">
      <p class="footer-heading">Hafa samband</p>
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      {/* The phone number is deliberately absent until a real one exists. It
          previously rendered "+354 000 0000" as a tappable tel: link — to a
          visitor auditing whether this operation is real, that is proof it
          isn't. A missing number costs nothing; a fake one costs everything. */}
      {
        site.contact.phone && (
          <a href={`tel:${site.contact.phone.replace(/\s/g, "")}`}>
            {site.contact.phone}
          </a>
        )
      }
      <div class="footer-social">
        <a href={site.social.instagram} rel="me noopener noreferrer" target="_blank">
          Instagram
        </a>
        <a href={site.social.facebook} rel="me noopener noreferrer" target="_blank">
          Facebook
        </a>
      </div>
    </div>
  </div>

  <div class="shell footer-bottom">
    <span>© {year} {site.name}</span>
    {/* Was "Reykjavík, Ísland" — the page's final fact told a father in
        Akureyri the service was not for him. */}
    <span>Þjálfun um allt land</span>
    <span class="footer-credit">
      {site.credit.label}{" "}
      <a href={site.credit.url} rel="noopener noreferrer" target="_blank">
        {site.credit.name}
      </a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: clamp(3rem, 2rem + 4vw, 5rem);
    border-top: 1px solid var(--color-line-soft);
    background: var(--color-sunken);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text);
  }
  .wordmark-text {
    font-family: var(--font-mark);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .mark {
    width: 1.75rem;
    --crest-color: var(--color-bronze);
  }
  .footer-tag {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-text-soft);
    max-width: 24ch;
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1.1rem;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .footer-col a {
    color: var(--color-text-soft);
    transition: color 200ms ease;
    width: fit-content;
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-col a:hover {
      color: var(--color-bronze);
    }
  }
  .footer-social {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    padding-block: 1.75rem;
    border-top: 1px solid var(--color-line-soft);
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  /* Underlined rather than coloured: in a muted bar the only affordance left
     is the rule under the text, and the credit must not read as brighter than
     the client's own name two lines above it. */
  .footer-credit a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, currentColor 40%, transparent);
    text-underline-offset: 0.25em;
    transition:
      color 200ms ease,
      text-decoration-color 200ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-credit a:hover {
      color: var(--color-bronze);
      text-decoration-color: currentColor;
    }
  }

  @media (min-width: 760px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr;
      gap: 3.5rem;
    }
  }
</style>
