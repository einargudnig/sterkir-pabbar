---
import { site, nav } from "../config/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a href="#efni" class="wordmark">
        <span class="crest-mark mark" aria-hidden="true"></span>
        {site.name}
      </a>
      <p class="footer-tag">{site.tagline}.</p>
    </div>

    <nav class="footer-nav" aria-label="Vefkort">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="footer-contact">
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      <a href={`tel:${site.contact.phone.replace(/\s/g, "")}`}>{site.contact.phone}</a>
      <div class="footer-social">
        <a href={site.social.instagram} rel="me noopener" target="_blank">Instagram</a>
        <a href={site.social.facebook} rel="me noopener" target="_blank">Facebook</a>
      </div>
    </div>
  </div>

  <div class="shell footer-bottom">
    <span>© {year} {site.name}</span>
    <span>{site.contact.city}, Ísland</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(2rem, 1rem + 3vw, 4rem);
    padding-top: clamp(2.5rem, 2rem + 3vw, 4rem);
    border-top: 1px solid var(--color-line);
    background: var(--color-paper-sink);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: 2.5rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--color-ink);
  }
  .mark {
    width: 1.6rem;
    height: 1.45rem;
    --crest-color: var(--color-forest);
  }
  .footer-tag {
    margin-top: 0.85rem;
    color: var(--color-ink-soft);
    max-width: 30ch;
  }
  .footer-nav,
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-nav a,
  .footer-contact a {
    color: var(--color-ink-soft);
    transition: color 160ms ease;
    width: fit-content;
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-nav a:hover,
    .footer-contact a:hover {
      color: var(--color-forest);
    }
  }
  .footer-social {
    display: flex;
    gap: 1rem;
    margin-top: 0.4rem;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.85rem;
    color: var(--color-ink-faint);
  }

  @media (min-width: 760px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
