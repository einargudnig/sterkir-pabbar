---
import { method } from "../config/site";
---

<section class="section method" id="adferd">
  <div class="shell method-grid">
    <header class="method-head">
      <p class="kicker">{method.kicker}</p>
      <h2 class="method-title">{method.title}</h2>
      <p class="method-intro">{method.intro}</p>
    </header>

    <ol class="steps">
      {
        method.steps.map((s) => (
          <li class="step">
            <span class="step-n">{s.n}</span>
            <div class="step-body">
              <h3 class="step-title">{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .method {
    background: var(--color-paper-sink);
  }
  .method-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
  }
  .method-head {
    align-self: start;
  }
  .method-title {
    font-size: var(--text-display);
    margin-block: 0.9rem 0;
    max-width: 14ch;
  }
  .method-intro {
    font-size: var(--text-lead);
    color: var(--color-ink-soft);
    margin-top: 1.1rem;
    max-width: 34ch;
  }

  .steps {
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
    padding-block: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    border-top: 1px solid var(--color-line);
  }
  .step:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  .step-n {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem);
    font-weight: 400;
    font-style: italic;
    color: var(--color-clay);
    line-height: 1;
  }
  .step-title {
    font-size: var(--text-subtitle);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .step-body p {
    color: var(--color-ink-soft);
    max-width: 52ch;
  }

  @media (min-width: 860px) {
    .method-grid {
      grid-template-columns: 0.85fr 1.15fr;
    }
    .method-head {
      position: sticky;
      top: 6rem;
    }
  }
</style>
