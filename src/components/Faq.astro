---
import { faq, sections } from "../config/site";
---

<section class="section faq" id="spurningar">
  <div class="shell faq-grid">
    <header class="faq-head">
      <h2 class="section-title faq-title">{sections.faqTitle}</h2>
    </header>

    {/*
      Two changes here, both about the same failure.

      `name="faq"` made this an exclusive accordion, so opening "Hvað kostar
      þetta?" silently closed "Ég hef varla æft í mörg ár — er þetta fyrir mig?".
      A father weighing cost against the fear of being too unfit literally could
      not hold both answers on screen.

      And the first item now ships open. "Já, einmitt þá." is the single most
      reassuring sentence on this site; it should not cost a click.
    */}
    <div class="faq-list">
      {
        faq.map((item, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>
              <span>{item.q}</span>
              <span class="faq-icon" aria-hidden="true" />
            </summary>
            <div class="faq-answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    align-items: start;
  }
  .faq-title {
    max-width: 12ch;
  }

  .faq-item {
    border-top: 1px solid var(--color-line-soft);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--color-line-soft);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.95rem + 0.6vw, 1.3rem);
    font-weight: 460;
    color: var(--color-text);
    transition: color 200ms ease;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    summary:hover {
      color: var(--color-bronze);
    }
  }

  .faq-icon {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    background: var(--color-bronze);
    border-radius: 2px;
    transition:
      transform 320ms var(--ease-out-expo),
      opacity 200ms ease;
  }
  .faq-icon::before {
    inset-block: 0;
    inset-inline: 45%;
  }
  .faq-icon::after {
    inset-inline: 0;
    inset-block: 45%;
  }
  .faq-item[open] .faq-icon::before {
    transform: scaleY(0);
    opacity: 0;
  }

  .faq-answer {
    padding-bottom: 1.75rem;
  }
  .faq-answer p {
    color: var(--color-text-soft);
    max-width: 58ch;
  }

  /* Smooth open/close where the browser can interpolate to `auto`.
     Elsewhere the panel simply snaps open, which is the native behaviour. */
  @supports selector(::details-content) {
    .faq-item::details-content {
      block-size: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        block-size 380ms var(--ease-out-expo),
        opacity 260ms ease,
        content-visibility 380ms allow-discrete;
    }
    .faq-item[open]::details-content {
      block-size: auto;
      opacity: 1;
    }
  }

  @media (min-width: 900px) {
    .faq-grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
    .faq-head {
      position: sticky;
      top: 7rem;
    }
  }
</style>
