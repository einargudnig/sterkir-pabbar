---
import { offerings } from "../config/site";
import { enquiryHref } from "../lib/booking";

// The page argues for one recommended path and two alternatives, so the
// layout says that too — rather than three interchangeable cards.
const featured = offerings.find((o) => o.featured);
const rest = offerings.filter((o) => !o.featured);
---

<section class="section" id="thjalfun">
  <div class="shell">
    <header class="section-head">
      <h2 class="section-title">Þrjár leiðir. Eitt markmið.</h2>
      <p class="section-lead">
        Sjálfstætt, saman eða í hóp. Það er leið sem passar þér.
      </p>
    </header>

    <div class="offer-layout">
      {
        featured && (
          <article class="offer-lead">
            <span class="offer-flag">{featured.tag}</span>
            <h3 class="offer-lead-name">{featured.name}</h3>
            <p class="offer-lead-price">{featured.price}</p>
            <p class="offer-lead-summary">{featured.summary}</p>
            <ul class="offer-features">
              {featured.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            {/* Label says what actually happens: this opens an email about
                this tier, it does not scroll to more reading. */}
            <a href={enquiryHref(featured.name)} class="btn btn-primary offer-lead-cta">
              Senda fyrirspurn
            </a>
          </article>
        )
      }

      <div class="offer-rest">
        {
          rest.map((o) => (
            <article class="offer-row">
              <div class="offer-row-head">
                <h3 class="offer-row-name">{o.name}</h3>
                <p class="offer-row-price">{o.price}</p>
              </div>
              <p class="offer-row-summary">{o.summary}</p>
              <ul class="offer-features offer-features--compact">
                {o.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <a href={enquiryHref(o.name)} class="link-arrow offer-row-cta">
                Senda fyrirspurn
                <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="M2 8h11M9 4l4 4-4 4"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .section-head {
    max-width: 44rem;
    margin-bottom: var(--spacing-block);
  }

  .offer-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    align-items: start;
  }

  /* ---- The recommended path ---- */
  .offer-lead {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 1.25rem + 2.5vw, 3rem);
    border-radius: 1rem;
    background:
      radial-gradient(
        90% 70% at 88% 4%,
        color-mix(in oklch, var(--color-bronze) 12%, transparent),
        transparent 62%
      ),
      var(--color-slate);
    border: 1px solid color-mix(in oklch, var(--color-bronze) 22%, transparent);
    overflow: hidden;
  }

  .offer-flag {
    align-self: flex-start;
    font-family: var(--font-mark);
    /* was 0.62rem (9.9px), below the 11px legibility floor */
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-base);
    background: var(--color-bronze);
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
  }

  .offer-lead-name {
    font-size: var(--text-title);
    margin-top: 1.5rem;
  }
  .offer-lead-price {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-bronze);
    margin-top: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .offer-lead-summary {
    color: var(--color-text-soft);
    margin-top: 1.5rem;
    max-width: 34ch;
  }

  .offer-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  .offer-features li {
    position: relative;
    padding-left: 1.75rem;
    font-size: 0.95rem;
    color: var(--color-text-soft);
  }
  .offer-features li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.48em;
    width: 0.7rem;
    height: 0.38rem;
    border-left: 1.5px solid var(--color-bronze);
    border-bottom: 1.5px solid var(--color-bronze);
    transform: rotate(-45deg);
  }

  .offer-lead-cta {
    margin-top: 2.5rem;
    align-self: flex-start;
  }

  /* ---- The two alternatives: no card chrome, just rhythm ---- */
  .offer-rest {
    display: flex;
    flex-direction: column;
  }
  .offer-row {
    padding-block: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
    border-top: 1px solid var(--color-line-soft);
  }
  .offer-row:last-child {
    border-bottom: 1px solid var(--color-line-soft);
  }
  .offer-row-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1.5rem;
  }
  .offer-row-name {
    font-size: var(--text-subtitle);
  }
  /* Matches .offer-lead-price exactly. These were 0.875rem/--color-text-muted,
     which made the 9.900 kr nationwide product — the scalable core of the
     business — the least legible price on the page. One class of fact gets one
     treatment, whichever tier is featured. */
  .offer-row-price {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-bronze);
    font-variant-numeric: tabular-nums;
  }
  .offer-row-summary {
    color: var(--color-text-soft);
    margin-top: 0.9rem;
    max-width: 40ch;
  }
  .offer-features--compact {
    gap: 0.55rem;
    margin-top: 1.25rem;
  }
  .offer-features--compact li {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .offer-features--compact li::before {
    border-color: var(--color-bronze-dim);
  }
  .offer-row-cta {
    margin-top: 1.35rem;
    font-size: 0.95rem;
  }

  @media (min-width: 900px) {
    .offer-layout {
      grid-template-columns: 1.05fr 1fr;
      gap: clamp(2.5rem, 1rem + 5vw, 5rem);
    }
    /* The first row's top rule would collide with the panel's top edge. */
    .offer-rest {
      padding-top: 0;
    }
  }
</style>
