---
import { offerings } from "../config/site";
---

<section class="section" id="thjalfun">
  <div class="shell">
    <header class="section-head">
      <p class="kicker">Þjálfunarleiðir</p>
      <h2 class="section-title">Þrjár leiðir. Eitt markmið — að þú endist.</h2>
      <p class="section-lead">
        Hvort sem þú vilt æfa sjálfur með plani, mæta í tíma eða vera með hópi
        af pöbbum — það er leið sem passar þér.
      </p>
    </header>

    <div class="offer-grid">
      {
        offerings.map((o) => (
          <article class={`offer${o.featured ? " offer--featured" : ""}`}>
            <div class="offer-top">
              <span class="offer-tag">{o.tag}</span>
              <h3 class="offer-name">{o.name}</h3>
              <p class="offer-price">{o.price}</p>
            </div>
            <p class="offer-summary">{o.summary}</p>
            <ul class="offer-features">
              {o.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <a
              href="#hafa-samband"
              class={`btn ${o.featured ? "btn-clay" : "btn-ghost"} offer-cta`}
            >
              Fá nánari upplýsingar
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: clamp(3.5rem, 2rem + 6vw, 6.5rem);
  }
  .section-head {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
  }
  .section-title {
    font-size: var(--text-display);
    margin-block: 0.9rem 0;
  }
  .section-lead {
    font-size: var(--text-lead);
    color: var(--color-ink-soft);
    margin-top: 1.1rem;
    max-width: 40ch;
  }

  .offer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .offer {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border-radius: 1.25rem;
    background: var(--color-paper-raised);
    border: 1px solid var(--color-line);
    transition:
      transform 260ms var(--ease-out-strong),
      box-shadow 260ms var(--ease-out-strong);
  }
  @media (hover: hover) and (pointer: fine) {
    .offer:hover {
      transform: translateY(-4px);
      box-shadow: 0 22px 40px -28px oklch(0.3 0.03 60 / 0.5);
    }
  }

  .offer--featured {
    background: linear-gradient(
      165deg,
      var(--color-forest) 0%,
      var(--color-forest-deep) 100%
    );
    border-color: transparent;
    color: var(--color-paper);
  }

  .offer-top {
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }
  .offer--featured .offer-top {
    border-bottom-color: color-mix(in oklch, var(--color-paper) 18%, transparent);
  }

  .offer-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-clay-deep);
    margin-bottom: 0.85rem;
  }
  .offer--featured .offer-tag {
    color: color-mix(in oklch, var(--color-paper) 72%, transparent);
  }

  .offer-name {
    font-size: var(--text-subtitle);
    font-weight: 500;
  }
  .offer-price {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .offer--featured .offer-price {
    color: color-mix(in oklch, var(--color-paper) 75%, transparent);
  }

  .offer-summary {
    color: var(--color-ink-soft);
    margin-bottom: 1.35rem;
  }
  .offer--featured .offer-summary {
    color: color-mix(in oklch, var(--color-paper) 82%, transparent);
  }

  .offer-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 1.75rem;
  }
  .offer-features li {
    position: relative;
    padding-left: 1.65rem;
    font-size: 0.95rem;
  }
  .offer-features li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.7rem;
    height: 0.4rem;
    border-left: 2px solid var(--color-forest);
    border-bottom: 2px solid var(--color-forest);
    transform: rotate(-45deg);
  }
  .offer--featured .offer-features li::before {
    border-color: color-mix(in oklch, var(--color-paper) 70%, transparent);
  }

  .offer-cta {
    margin-top: auto;
    width: 100%;
  }
  .btn-clay {
    background: var(--color-clay);
    color: var(--color-paper);
  }
  @media (hover: hover) and (pointer: fine) {
    .btn-clay:hover {
      background: var(--color-clay-deep);
    }
    .offer--featured .btn-ghost:hover {
      background: color-mix(in oklch, var(--color-paper) 12%, transparent);
    }
  }
  .offer--featured .offer-cta.btn-ghost {
    border-color: color-mix(in oklch, var(--color-paper) 25%, transparent);
    color: var(--color-paper);
  }

  @media (min-width: 800px) {
    .offer-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    /* Break the grid: lift the featured card */
    .offer--featured {
      transform: translateY(-1.25rem);
    }
    @media (hover: hover) and (pointer: fine) {
      .offer--featured:hover {
        transform: translateY(-1.6rem);
      }
    }
  }
</style>
