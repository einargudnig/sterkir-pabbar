---
import { forDads } from "../config/site";
---

{/*
  No kicker, no ordinals, no hairlines.

  This section used to be built from the same primitive as every other one —
  eyebrow, heading, rule-separated rows — and numbered 01–04 despite these four
  statements having no order. Stripped to pure typography it now reads as a
  distinct move rather than a fourth repetition of the same idea.
*/}
<section class="section fordads">
  <div class="shell">
    <h2 class="section-title fordads-title">{forDads.title}</h2>

    <ul class="reasons">
      {forDads.points.map((point) => <li class="reason">{point}</li>)}
    </ul>
  </div>
</section>

<style>
  .fordads-title {
    max-width: 17ch;
    margin-bottom: clamp(3rem, 2rem + 5vw, 6rem);
  }

  /* Short statements set large, separated by space alone. The copy was cut to
     fragments precisely so this could carry without chrome. */
  .reasons {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) clamp(2.5rem, 1rem + 5vw, 6rem);
  }
  .reason {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.05rem + 1.5vw, 2rem);
    font-weight: 420;
    line-height: 1.24;
    letter-spacing: -0.02em;
    color: var(--color-text);
    max-width: 22ch;
    text-wrap: balance;
  }

  @media (min-width: 760px) {
    .reasons {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
