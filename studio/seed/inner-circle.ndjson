{"_id": "plan-fitutap-3", "_type": "trainingPlan", "title": "Þrisvar í viku — fitutap (sýnidæmi)", "goal": "fitutap", "equipment": "raektarstod", "sessionsPerWeek": 3, "intro": "Sýnidæmi sem Einar setti inn til að prófa útlitið. Eyddu því þegar þitt eigið plan er tilbúið.", "sessions": [{"_key": "s1", "_type": "session", "title": "Dagur A — neðri hluti", "exercises": [{"_key": "a1", "_type": "planExercise", "exercise": {"_type": "reference", "_ref": "exercise-hnebeygja"}, "sets": 3, "reps": "8–10", "note": "Farðu eins djúpt og þú ræður vel við."}, {"_key": "a2", "_type": "planExercise", "exercise": {"_type": "reference", "_ref": "exercise-rumensk-rettstodulyfta"}, "sets": 3, "reps": "10"}, {"_key": "a3", "_type": "planExercise", "exercise": {"_type": "reference", "_ref": "exercise-utfall"}, "sets": 2, "reps": "10 á hvorn fót"}]}, {"_key": "s2", "_type": "session", "title": "Dagur B — efri hluti", "exercises": [{"_key": "b1", "_type": "planExercise", "exercise": {"_type": "reference", "_ref": "exercise-bekkpressa"}, "sets": 3, "reps": "8"}, {"_key": "b2", "_type": "planExercise", "exercise": {"_type": "reference", "_ref": "exercise-nidurtog"}, "sets": 3, "reps": "10–12"}, {"_key": "b3", "_type": "planExercise", "exercise": {"_type": "reference", "_ref": "exercise-axlapressa"}, "sets": 3, "reps": "10"}]}, {"_key": "s3", "_type": "session", "title": "Dagur C — allur líkaminn", "exercises": [{"_key": "c1", "_type": "planExercise", "exercise": {"_type": "reference", "_ref": "exercise-rettstodulyfta"}, "sets": 3, "reps": "5", "note": "Byrjaðu létt."}, {"_key": "c2", "_type": "planExercise", "exercise": {"_type": "reference", "_ref": "exercise-rodur-i-vel"}, "sets": 3, "reps": "10"}, {"_key": "c3", "_type": "planExercise", "exercise": {"_type": "reference", "_ref": "exercise-planki"}, "sets": 3, "reps": "30–45 sek"}]}]}
{"_id": "article-byrjadu-minna-en-thu-heldur", "_type": "article", "title": "Byrjaðu minna en þú heldur", "slug": {"_type": "slug", "current": "byrjadu-minna-en-thu-heldur"}, "category": "ad-byrja", "excerpt": "Algengasta ástæðan fyrir því að pabbar hætta eftir þrjár vikur er ekki leti. Það er að þeir byrjuðu of stórt.", "body": [{"_key": "p0", "_type": "block", "style": "normal", "markDefs": [], "children": [{"_key": "p0s", "_type": "span", "text": "Þú hefur ekki æft í nokkur ár. Fyrsta vikan gengur vel því þú ert spenntur og ferskur.", "marks": []}]}, {"_key": "p1", "_type": "block", "style": "normal", "markDefs": [], "children": [{"_key": "p1s", "_type": "span", "text": "Svo kemur þriðja vikan, barnið sefur illa, og planið sem þurfti fimm daga hrynur.", "marks": []}]}, {"_key": "p2", "_type": "block", "style": "normal", "markDefs": [], "children": [{"_key": "p2s", "_type": "span", "text": "Byggðu planið í kringum verstu vikuna þína, ekki þá bestu. Þá heldur það.", "marks": []}]}]}
{"_id": "article-protein-an-thess-ad-flaekja", "_type": "article", "title": "Prótein án þess að flækja málin", "slug": {"_type": "slug", "current": "protein-an-thess-ad-flaekja"}, "category": "matarraedi", "excerpt": "Þú þarft ekki að vigta allt. Þú þarft að vita hvar próteinið er í því sem þú borðar hvort eð er.", "body": [{"_key": "p0", "_type": "block", "style": "normal", "markDefs": [], "children": [{"_key": "p0s", "_type": "span", "text": "Flestir sem ætla að léttast borða of lítið prótein, ekki of mikið.", "marks": []}]}, {"_key": "p1", "_type": "block", "style": "normal", "markDefs": [], "children": [{"_key": "p1s", "_type": "span", "text": "Hafðu próteingjafa með í hverri máltíð og þú ert kominn langleiðina.", "marks": []}]}]}
{"_id": "article-thegar-vikan-hrynur", "_type": "article", "title": "Þegar vikan hrynur", "slug": {"_type": "slug", "current": "thegar-vikan-hrynur"}, "category": "ad-halda-afram", "excerpt": "Hvað á að gera þegar þú misstir úr þrjár æfingar í röð.", "body": [{"_key": "p0", "_type": "block", "style": "normal", "markDefs": [], "children": [{"_key": "p0s", "_type": "span", "text": "Ekkert sérstakt. Þú byrjar bara aftur á næstu æfingu í planinu.", "marks": []}]}, {"_key": "p1", "_type": "block", "style": "normal", "markDefs": [], "children": [{"_key": "p1s", "_type": "span", "text": "Þú tekur ekki „upp“ æfingar sem fóru forgörðum. Það er leiðin í meiðsli og leiðindi.", "marks": []}]}]}
